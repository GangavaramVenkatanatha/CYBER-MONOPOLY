# Copy this file to .env (local dev) and also set each value in the Vercel
# project's Settings -> Environment Variables before deploying. See
# DEPLOYMENT.md for exact click-by-click steps.

# Supabase project URL. Find it: Supabase dashboard -> your project ->
# Project Settings -> API -> "Project URL".
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase SERVICE ROLE key. Find it: Supabase dashboard -> your project ->
# Project Settings -> API -> "Project API keys" -> service_role (click Reveal).
# SECRET — this key bypasses Row Level Security. It is used ONLY inside the
# /api serverless functions (server-side). Never put it in anything under
# /public, never prefix it with NEXT_PUBLIC_/VITE_/etc., never send it to a
# browser.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase ANON (public) key. Find it: same "Project API keys" section as
# above -> anon / public. This one IS meant to reach the browser — the
# client uses it only to open a Supabase Realtime connection (no direct
# table access is granted to it; see supabase/migrations/0001_init.sql).
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Random long string used to derive the (unguessable) Realtime channel name
# for a board from its PIN, so viewing a board's live state still requires
# knowing that board's PIN (this is a server-side secret; generate any long
# random string, e.g. `openssl rand -hex 32`, and never reuse it elsewhere).
CHANNEL_SALT=change-me-to-a-long-random-string

# Optional but recommended. Protects /api/cron/sweep (the belt-and-suspenders
# background sweep for expired quizzes/duels — the primary expiry mechanism
# is each client's own countdown calling /api/expire/*, this is just a
# supplement) from being triggered by anyone who finds the URL. When this is
# set, Vercel automatically sends it as `Authorization: Bearer <value>` for
# scheduled Cron invocations. Generate any long random string.
CRON_SECRET=change-me-to-another-long-random-string
